# Local EVM is the default. No wallet or AI API key required.
CHAIN_MODE=local
VAULT_PORT=4391
RESEARCH_PORT=4392
WRITER_PORT=4393
UI_PORT=4390
# Set CHAIN_MODE=monad only after deploying with npm run deploy:monad.
MONAD_RPC_URL=https://testnet-rpc.monad.xyz
MONAD_CHAIN_ID=10143
MONAD_EXPLORER=https://testnet.monadscan.com
MONAD_CONTRACT_ADDRESS=
# Dedicated TESTNET wallet. Never use your main wallet. Not sent to the browser.
MONAD_PRIVATE_KEY=
# Optional OpenAI-compatible LLM. Unset uses an explicitly labelled template demo.
LLM_API_KEY=
LLM_BASE_URL=https://api.moonshot.ai/v1
LLM_MODEL=kimi-k2.5
