{
  "name": "agentpassport",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc --noEmit && vite build",
    "start": "node scripts/dev.mjs --production",
    "public": "node scripts/public.mjs",
    "compile": "node scripts/compile.mjs",
