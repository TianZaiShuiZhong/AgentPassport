    "ethers": "^6.15.0",
    "express": "^5.1.0",
    "ganache": "^7.9.2",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "solc": "0.8.30",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "prettier": "3.9.9",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  }
